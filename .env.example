# LucidLink Workspace Manager - Environment Configuration
# Copy to .env and fill in your values

# Service account token for LucidLink API authentication
LUCIDLINK_TOKEN=sa_live:your_key:your_secret

# UGREEN MinIO defaults (used when creating filespaces)
MINIO_ENDPOINT=https://ugreen-nas.tail333a1d.ts.net
MINIO_BUCKET=lucidlink
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_REGION=us-east-1
