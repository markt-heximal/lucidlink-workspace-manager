# Frontend (Vite) build-time config for the LucidLink workspace manager UI.
# Copy to `.env` and fill in. `.env` is gitignored; this template is not.
#
# WARNING: every VITE_* value is inlined into the client bundle and is therefore
# readable by anyone who loads the app. Use a MinIO key scoped to the `lucidlink`
# bucket only — never an admin key. The durable fix is to move filespace creation
# behind the file service (which holds credentials server-side) and drop the two
# key vars below entirely.

# Object-store defaults used to pre-fill the "create filespace" form.
VITE_MINIO_ENDPOINT=https://ugreen-nas.tail333a1d.ts.net
VITE_MINIO_BUCKET=lucidlink
VITE_MINIO_REGION=us-east-1
VITE_MINIO_ACCESS_KEY=
VITE_MINIO_SECRET_KEY=
