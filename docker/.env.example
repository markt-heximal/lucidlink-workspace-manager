# LucidLink Workspace Manager - Environment Configuration
# Copy to .env and fill in your values

# Service account token for LucidLink API authentication
LUCIDLINK_TOKEN=sa_live:your_key:your_secret

# LucidLink SDK cache maximums per linked filespace, in GiB (fractions allowed).
# Each linked filespace gets its own data + metadata cache in the container's
# writable layer; worst case per service is
#   LUCIDLINK_MAX_CLIENTS x LUCIDLINK_MAX_LINKED_FILESPACES x (data + metadata).
# Defaults match SDK 1.0's own (5 + 1); SDK 0.14 used 25 + 5.
LUCIDLINK_CACHE_DATA_GB=5
LUCIDLINK_CACHE_METADATA_GB=1

# UGREEN MinIO defaults (used when creating filespaces)
MINIO_ENDPOINT=https://ugreen-nas.tail333a1d.ts.net
MINIO_BUCKET=lucidlink
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_REGION=us-east-1

# /agent/query LLM — OpenAI-compatible chat/completions endpoint.
# Leave blank to disable the agent endpoint (it returns 503 until set).
# Example (on-prem Ollama): LLM_BASE_URL=http://10.0.1.233:11434/v1  LLM_MODEL=qwen2.5-coder:32b
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT=180
# Optional bearer key for the LLM endpoint (cloud providers)
LLM_API_KEY=

# --- Owner sign-in, vault and indexer (docs/INDEXER.md) ---
# Fernet key for the encrypted token vault. Generate once and keep it safe:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_KEY=
# The web app's Supabase project (publishable values) and the one account allowed in.
SUPABASE_URL=https://vqbnkxekmbyailcpxbjw.supabase.co
SUPABASE_ANON_KEY=
OWNER_EMAIL=
OWNER_USER_ID=
# Shared secret between the file service and the indexer (any long random string).
INDEXER_INTERNAL_KEY=
# OpenAI-compatible embeddings endpoint (e.g. Ollama on the Spark).
EMBED_BASE_URL=
EMBED_MODEL=nomic-embed-text
EMBED_API_KEY=
# Ruvector mirror for fast search; local search is used when unset or down.
RUVECTOR_URL=https://spark-47d8.tail333a1d.ts.net/ruvector
RUVECTOR_API_KEY=
SYNC_INTERVAL_SEC=300
# Connected block storage (In Place, Phase A): index a mounted share where it
# lives, read-only. BLOCK_SOURCE_PATH is the host folder (mounted into the
# indexer at /block/source1:ro); BLOCK_SOURCES names it. The name must not be
# the name of a filespace in that workspace. BLOCK_SOURCE_WORKSPACE defaults to
# the vault's active workspace.
# Up to six folders: BLOCK_SOURCE_PATH, then BLOCK_SOURCE_PATH_2 … _6, mounted
# at /block/source1 … /block/source6. Quote paths that contain spaces.
#BLOCK_SOURCE_PATH=/Volumes/Projects
#BLOCK_SOURCE_PATH_2="/Volumes/Archive 1"
#BLOCK_SOURCES=NAS=/block/source1;Archive-1=/block/source2
#BLOCK_SOURCE_WORKSPACE=

# --- LucidLink update alerts (docs/UPDATES.md) ---
# ntfy push to your iPhone (install the ntfy app and subscribe to the topic).
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
# Optional: generic JSON webhook and/or email via Resend.
ALERT_WEBHOOK_URL=
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
UPDATE_CHECK_INTERVAL_SEC=21600
